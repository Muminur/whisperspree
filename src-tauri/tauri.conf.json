{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperSpree",
  "version": "0.1.0",
  "identifier": "com.whisperspree.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "hud",
        "url": "index.html",
        "width": 320,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "index.html",
        "title": "WhisperSpree Settings",
        "width": 900,
        "height": 640,
        "visible": false
      },
      {
        "label": "history",
        "url": "index.html",
        "title": "WhisperSpree History",
        "width": 900,
        "height": 640,
        "visible": false
      },
      {
        "label": "onboarding",
        "url": "index.html",
        "title": "Welcome to WhisperSpree",
        "width": 720,
        "height": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
